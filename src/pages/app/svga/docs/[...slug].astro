---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Section from "../../../../layouts/Section.astro";
import "../../../../styles/svga-docs.scss";
import {
    BASE,
    SECTIONS,
    parseId,
    titleOf,
    shortTitleOf,
    hrefOf,
} from "./_svga-docs.mjs";

export async function getStaticPaths() {
    const entries = await getCollection("svgaDocs");
    if (entries.length === 0) {
        throw new Error(
            "No SVG Animator docs found in src/content/docs2. " +
                "Run `yarn sync:svga-docs` and commit the result.",
        );
    }

    const ordered = entries.sort(
        (a, b) => parseId(a.id).order - parseId(b.id).order,
    );

    return ordered.map((entry, index) => ({
        params: { slug: entry.id === "README" ? undefined : entry.id },
        props: {
            entry,
            prev: ordered[index - 1],
            next: ordered[index + 1],
            ordered,
        },
    }));
}

const { entry, prev, next, ordered } = Astro.props;
const { Content } = await render(entry);

const overview = ordered.find((item) => item.id === "README");
const groups = SECTIONS.map(([key, label]) => ({
    key,
    label,
    items: ordered.filter((item) => parseId(item.id).section === key),
})).filter((group) => group.items.length > 0);

const currentHref = hrefOf(entry);
---

<BaseLayout title={titleOf(entry)}>
    <!-- flex-1 keeps the bright background filling the viewport on short pages. -->
    <div class="bg-base-bright pt-navDouble flex-1">
        <Section
            className="svga-docs"
            bgColor="bg-base-bright"
            color="text-base-dark-blue"
            maxWidth="max-w-custom-wide"
            page
        >
            <div class="docs-container">
                <nav class="sidebar" aria-label="SVG Animator documentation">
                    {
                        overview && (
                            <div class="category-group">
                                <a
                                    href={BASE}
                                    class:list={[
                                        "doc-link",
                                        { active: currentHref === BASE },
                                    ]}
                                >
                                    Overview
                                </a>
                            </div>
                        )
                    }
                    {
                        groups.map((group) => (
                            <div class="category-group">
                                <button class="category-header" type="button" aria-expanded="true">
                                    <h3 class="category-title">{group.label}</h3>
                                    <svg
                                        class="chevron"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        aria-hidden="true"
                                    >
                                        <polyline points="6 9 12 15 18 9" />
                                    </svg>
                                </button>
                                <ul class="category-content">
                                    <div class="category-content-wrapper">
                                        {group.items.map((item) => (
                                            <li>
                                                <a
                                                    href={hrefOf(item)}
                                                    class:list={[
                                                        "doc-link",
                                                        {
                                                            active:
                                                                hrefOf(item) === currentHref,
                                                        },
                                                    ]}
                                                >
                                                    {shortTitleOf(item)}
                                                </a>
                                            </li>
                                        ))}
                                    </div>
                                </ul>
                            </div>
                        ))
                    }
                </nav>

                <article class="content prose max-w-none">
                    <Content />

                    {
                        (prev || next) && (
                            <nav class="doc-navigation" aria-label="Pagination">
                                <div class="nav-link-container">
                                    {prev && (
                                        <a href={hrefOf(prev)} class="nav-link">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <polyline points="15 18 9 12 15 6" />
                                            </svg>
                                            <span class="nav-link-text">
                                                <span class="nav-label">Previous</span>
                                                <span class="nav-title">{shortTitleOf(prev)}</span>
                                            </span>
                                        </a>
                                    )}
                                </div>
                                <div class="nav-link-container">
                                    {next && (
                                        <a href={hrefOf(next)} class="nav-link next-link">
                                            <span class="nav-link-text">
                                                <span class="nav-label">Next</span>
                                                <span class="nav-title">{shortTitleOf(next)}</span>
                                            </span>
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                <polyline points="9 18 15 12 9 6" />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </nav>
                        )
                    }
                </article>
            </div>
        </Section>
    </div>
</BaseLayout>

<script>
    document.querySelectorAll(".category-header").forEach((header) => {
        header.addEventListener("click", () => {
            const group = header.closest(".category-group");
            const collapsed = group.classList.toggle("collapsed");
            header.setAttribute("aria-expanded", String(!collapsed));
        });
    });

    // Mermaid is ~400kB, so it is only pulled in on the pages that draw a
    // diagram. The blocks stay hidden until this settles, successfully or not,
    // to avoid flashing the diagram source.
    async function renderMermaid() {
        const blocks = document.querySelectorAll("pre.mermaid");
        if (blocks.length === 0) return;

        try {
            const { default: mermaid } = await import("mermaid");
            mermaid.initialize({
                startOnLoad: false,
                theme: "base",
                // The docs are our own source, and the diagrams use HTML in
                // node labels (<b>, <br/>), which "strict" would escape.
                securityLevel: "loose",
            });
            await mermaid.run({ nodes: blocks });
        } catch (error) {
            console.error("Could not render mermaid diagrams", error);
        } finally {
            blocks.forEach((block) => block.classList.add("mermaid-ready"));
        }
    }

    renderMermaid();
</script>

<style is:global>
    .docs-container pre.mermaid {
        background: none !important;
        padding: 0;
        overflow-x: auto;
        text-align: center;
        visibility: hidden;
    }

    .docs-container pre.mermaid.mermaid-ready {
        visibility: visible;
    }

    .docs-container pre.mermaid svg {
        max-width: 100%;
        height: auto;
    }
</style>
